# M03-G2 experimental environment. NO SECRETS IN THIS FILE.
# Secrets are referenced by path or required from the caller's environment:
#   FREELLM_KEY            caller env, only when starting the experimental OpenCode (G3+)
#   control-plane API key  file referenced by the tunnel profile (never copied)
#   OpenCode password      generated at start into $EXP_RUN/opencode.password (0600)

# Experimental runtime state lives OUTSIDE the repo and outside the stable checkout.
# EXP_ROOT may only be this dedicated directory or a subtree of its .sandbox/
# (tests); lib.sh guard_root enforces it before any mkdir/chmod/write/rm.
EXP_ROOT_DEFAULT="$HOME/.local/state/constructor-g2-exp"
EXP_ROOT="${EXP_ROOT:-$EXP_ROOT_DEFAULT}"
EXP_RUN="$EXP_ROOT/run"
EXP_LOGS="$EXP_ROOT/logs"

# Lab code (never the stable checkout).
EXP_LAB="$HOME/constructor-general-linux-m01-lab"
EXP_ADAPTER_DIR="$EXP_LAB/mcp-opencode-adapter"

# Experimental OpenCode: own port, own XDG homes (own SQLite DB), cwd = lab.
EXP_OPENCODE_HOST="127.0.0.1"
EXP_OPENCODE_PORT="4097"
EXP_OPENCODE_XDG_DATA="$EXP_ROOT/opencode/data"
EXP_OPENCODE_XDG_STATE="$EXP_ROOT/opencode/state"
EXP_OPENCODE_XDG_CACHE="$EXP_ROOT/opencode/cache"
EXP_OPENCODE_XDG_CONFIG="$EXP_ROOT/opencode/config"

# Experimental adapter state (env overrides already supported by the adapter).
EXP_SUBSCRIPTIONS_FILE="$EXP_ROOT/adapter/subscriptions.json"
EXP_OUTBOX_FILE="$EXP_ROOT/adapter/event-outbox.json"
# Mission map: fixed by code to $EXP_ADAPTER_DIR/.mission-map.json (lab path,
# gitignored), i.e. already disjoint from the stable checkout's map.

# MCP Events emitter: OFF unless explicitly switched on for a later gate.
EXP_EVENTS_EMITTER="${EXP_EVENTS_EMITTER:-off}"

# Tunnel: a DIFFERENT tunnel than the stable one, own health port.
EXP_TUNNEL_ID="${EXP_TUNNEL_ID:-}"   # must be provided at G3; never the stable id
EXP_TUNNEL_HEALTH="127.0.0.1:8081"
EXP_TUNNEL_PROFILE="$EXP_ROOT/tunnel/opencode-adapter-exp.yaml"
EXP_CONTROL_PLANE_KEY_FILE="$HOME/.config/tunnel-client/secrets/control-plane-api-key"

# Stable identifiers the experimental tooling must refuse to touch.
STABLE_CHECKOUT="$HOME/opencode-constructor-e2e"
STABLE_OPENCODE_PORT="4096"
STABLE_TUNNEL_ID="tunnel_6ac2f4a0837c8191b3bdcaf04f49a5ed"
STABLE_TUNNEL_HEALTH="127.0.0.1:8080"
