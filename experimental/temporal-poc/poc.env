# POC-TEMPORAL-CONSTRUCTOR-001 — isolated runtime. No secrets in this file.
POC_ROOT="$HOME/.local/state/constructor-temporal-poc"
POC_DIR="$HOME/constructor-general-linux-m01-lab/experimental/temporal-poc"
TEMPORAL_BIN="$POC_ROOT/bin/temporal"
TEMPORAL_DB="$POC_ROOT/data/temporal.db"     # persistent SQLite (not in-memory)
TEMPORAL_IP="127.0.0.1"
TEMPORAL_PORT="7243"        # gRPC frontend (default 7233 left untouched)
TEMPORAL_UI_PORT="8243"
TEMPORAL_HTTP_PORT="7244"
TEMPORAL_METRICS_PORT="7245"
POC_TASK_QUEUE="constructor-poc"
POC_EFFECTS_DIR="$POC_ROOT/effects"         # idempotency ledger of external effects
POC_RUN="$POC_ROOT/run"
POC_LOGS="$POC_ROOT/logs"
